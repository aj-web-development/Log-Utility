LOGUTY_ADMIN_USERNAME=admin
LOGUTY_ADMIN_PASSWORD=admin

# Where the image is pushed to / pulled from. Only meaningful together: the build machine
# builds+tags+pushes this exact name:tag, and every target environment's .env must set the
# SAME values so `docker compose pull` fetches that build - see docs/DEPLOYMENT.md.
IMAGE_NAME=your-registry/logutility
IMAGE_TAG=latest

# Host path that's the shared root for every target project's logs/backups on this
# environment (dev/staging/prod each set their own). Mounted read-only into the
# container at the same path - see docker-compose.yml.
LOGS_HOST_ROOT=/app

# Host path where this app's OWN logs (not the target apps' logs above) land - see
# logback-spring.xml and docker-compose.yml. Must exist and be writable by uid 10001
# before first start: mkdir -p "$LOG_HOST_DIR" && chown 10001:10001 "$LOG_HOST_DIR"
LOG_HOST_DIR=/home/intense/APP_LOGS/log-utility/logs

# --- Database: point at your already-running instance, pick ONE engine --------------
JDBC_DATABASE_URL=jdbc:postgresql://your-db-host:5432/logutility
# JDBC_DATABASE_URL=jdbc:mysql://your-db-host:3306/logutility
# JDBC_DATABASE_URL=jdbc:sqlserver://your-db-host:1433;databaseName=logutility;encrypt=true;trustServerCertificate=true

JDBC_DATABASE_USERNAME=logutility
JDBC_DATABASE_PASSWORD=change-me

# Must match the engine above - TIMESTAMP for Postgres/MySQL (default), DATETIME2 for
# SQL Server:
FLYWAY_TIMESTAMP_TYPE=TIMESTAMP
# FLYWAY_TIMESTAMP_TYPE=DATETIME2
